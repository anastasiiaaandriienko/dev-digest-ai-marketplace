{
  "name": "dev-digest-ai-marketplace-catalog",
  "private": true,
  "version": "0.1.0",
  "description": "Static catalog of the dev-digest-ai-marketplace plugins (GitHub Pages).",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "index": "node ../scripts/build-index.mjs --out public",
    "dev": "npm run index && vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run index && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "minisearch": "7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
